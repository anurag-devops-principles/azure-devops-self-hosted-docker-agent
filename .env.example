# Azure DevOps organization URL (not the repository URL)
AZP_URL=https://dev.azure.com/your-organization

# Create a PAT with Agent Pools: Read & manage. Never commit the real token.
AZP_TOKEN=paste-your-personal-access-token-here

# Both computers may use the same pool. The agent names must be different.
AZP_POOL=Default
AZP_AGENT_NAME=windows-docker-agent

# Optional: useful when a host runs more than one agent.
# AZP_CONTAINER_NAME=azure-devops-agent
# AZP_IMAGE=azure-devops-self-hosted-agent:local
